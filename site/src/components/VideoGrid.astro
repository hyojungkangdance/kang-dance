---
interface VideoItem {
  title: string;
  caption: string;
  youtubeId: string;
}

interface Props {
  videos: readonly VideoItem[];
}

const { videos } = Astro.props;
---

<section class="video-grid" aria-label="Videos">
  {
    videos.map((video) => (
      <article class="video-card">
        <h2>{video.title}</h2>
        <div class="video-frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`}
            title={video.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <p>{video.caption}</p>
      </article>
    ))
  }
</section>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    width: 100%;
    max-width: 62rem;
    padding-bottom: 4rem;
  }

  .video-card {
    min-width: 0;
  }

  .video-card h2 {
    margin: 0 0 0.65rem;
    font-family: "Playfair Display", "Noto Serif KR", serif;
    font-size: 1rem;
    line-height: 1.55;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  :global(html[lang="ko"]) .video-card h2 {
    font-family: "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
    letter-spacing: 0.02em;
  }

  .video-frame {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    overflow: hidden;
    background: #000;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-card p {
    margin-top: 0.65rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .video-grid {
      grid-template-columns: 1fr;
      gap: 1.3rem;
      padding-bottom: 3rem;
    }
  }
</style>
