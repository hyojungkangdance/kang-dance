---
type Language = "en" | "de" | "ko";

interface Props {
  lang?: Language;
  activePage?: string;
}

interface NavigationItem {
  key: string;
  label?: string;
  href: string;
  icon?: boolean;
  ariaLabel?: string;
}

const { lang = "en", activePage = "" } = Astro.props;

const navigation: Record<Language, NavigationItem[]> = {
  en: [
    { key: "home", href: "/", icon: true, ariaLabel: "Home" },
    { key: "bio", label: "bio", href: "/bio.html" },
    { key: "news", label: "news", href: "/news.html" },
    { key: "media", label: "media", href: "/media.html" },
    { key: "press", label: "press", href: "/press.html" },
    { key: "contact", label: "contact", href: "/contact.html" },
  ],
  de: [
    { key: "home", href: "/de/", icon: true, ariaLabel: "Startseite" },
    { key: "bio", label: "bio", href: "/de/bio.html" },
    { key: "news", label: "news", href: "/de/news.html" },
    { key: "media", label: "medien", href: "/de/media.html" },
    { key: "press", label: "presse", href: "/de/press.html" },
    { key: "contact", label: "kontakt", href: "/de/contact.html" },
  ],
  ko: [
    { key: "home", href: "/ko/", icon: true, ariaLabel: "\ud648" },
    { key: "bio", label: "\ud504\ub85c\ud544", href: "/ko/bio.html" },
    { key: "news", label: "\uc18c\uc2dd", href: "/ko/news.html" },
    { key: "media", label: "\ubbf8\ub514\uc5b4", href: "/ko/media.html" },
    { key: "press", label: "\uc5b8\ub860", href: "/ko/press.html" },
    { key: "contact", label: "\ubb38\uc758", href: "/ko/contact.html" },
  ],
};

const currentNavigation = navigation[lang];
const currentPath = Astro.url.pathname || "/";
let pathWithoutLanguage = currentPath.replace(/^\/(?:de|ko)(?=\/|$)/, "");

if (pathWithoutLanguage === "") {
  pathWithoutLanguage = "/";
}

const localizedPath = (targetLanguage: Language) => {
  if (targetLanguage === "en") {
    return pathWithoutLanguage;
  }

  if (pathWithoutLanguage === "/") {
    return `/${targetLanguage}/`;
  }

  return `/${targetLanguage}${pathWithoutLanguage}`;
};

const languages = [
  { key: "en" as const, label: "EN", fullLabel: "English", href: localizedPath("en") },
  { key: "de" as const, label: "DE", fullLabel: "Deutsch", href: localizedPath("de") },
  { key: "ko" as const, label: "\ud55c", fullLabel: "\ud55c\uad6d\uc5b4", href: localizedPath("ko") },
];

const alternateLanguages = languages.filter((language) => language.key !== lang);
---

<header class="hk-header">
  <a
    class="hk-logo"
    href={lang === "en" ? "/" : `/${lang}/`}
    aria-label="Hyo-Jung Kang - Home"
  >
    <span class="hk-logo-en">Hyo-Jung KANG</span>
    <span class="hk-logo-ko" lang="ko">{"\uac15\ud6a8\uc815"}</span>
  </a>

  <div class="hk-desktop-navigation">
    <nav class="hk-main-navigation" aria-label="Main navigation">
      {
        currentNavigation.map((item) =>
          item.icon ? (
            <a
              href={item.href}
              class:list={["hk-home-link", item.key === activePage && "is-active"]}
              aria-label={item.ariaLabel}
              title={item.ariaLabel}
              aria-current={item.key === activePage ? "page" : undefined}
            >
              <img src="/favicon-32x32.png" alt="" width="20" height="20" />
            </a>
          ) : (
            <a
              href={item.href}
              class={item.key === activePage ? "is-active" : ""}
              aria-current={item.key === activePage ? "page" : undefined}
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <nav class="hk-language-navigation" aria-label="Choose language">
      {
        alternateLanguages.map((language) => (
          <a
            href={language.href}
            lang={language.key}
            hreflang={language.key}
            aria-label={language.fullLabel}
            title={language.fullLabel}
          >
            {language.label}
          </a>
        ))
      }
    </nav>
  </div>

  <button
    class="hk-menu-button"
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="hk-mobile-menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div id="hk-mobile-menu" class="hk-mobile-menu" hidden>
    <nav class="hk-mobile-main-navigation" aria-label="Mobile navigation">
      {
        currentNavigation.map((item) =>
          item.icon ? (
            <a
              href={item.href}
              class:list={["hk-mobile-home-link", item.key === activePage && "is-active"]}
              aria-label={item.ariaLabel}
              title={item.ariaLabel}
            >
              <img src="/favicon-32x32.png" alt="" width="28" height="28" />
            </a>
          ) : (
            <a href={item.href} class={item.key === activePage ? "is-active" : ""}>
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <nav class="hk-mobile-language-navigation" aria-label="Choose language">
      {
        alternateLanguages.map((language) => (
          <a
            href={language.href}
            lang={language.key}
            hreflang={language.key}
            aria-label={language.fullLabel}
            title={language.fullLabel}
          >
            {language.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector(".hk-menu-button");
  const mobileMenu = document.querySelector("#hk-mobile-menu");

  if (menuButton instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement) {
    const closeMenu = () => {
      menuButton.setAttribute("aria-expanded", "false");
      menuButton.setAttribute("aria-label", "Open menu");
      mobileMenu.hidden = true;
      document.body.classList.remove("hk-menu-open");
    };

    const openMenu = () => {
      menuButton.setAttribute("aria-expanded", "true");
      menuButton.setAttribute("aria-label", "Close menu");
      mobileMenu.hidden = false;
      document.body.classList.add("hk-menu-open");
    };

    menuButton.addEventListener("click", () => {
      const isOpen = menuButton.getAttribute("aria-expanded") === "true";
      if (isOpen) closeMenu();
      else openMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }
</script>

<style>
  .hk-header {
    box-sizing: border-box;
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    width: 100%;
    min-height: 62px;
    padding:
      max(0.8rem, env(safe-area-inset-top))
      max(1.8rem, env(safe-area-inset-right))
      0.7rem
      max(1.8rem, env(safe-area-inset-left));
    color: #fff;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.88), rgba(0, 0, 0, 0));
  }

  .hk-logo {
    position: static !important;
    top: auto !important;
    display: flex !important;
    flex: 0 0 auto;
    flex-direction: column !important;
    align-items: flex-start;
    justify-content: flex-start;
    align-self: flex-start;
    margin: 0 !important;
    padding: 0 !important;
    color: #fff;
    line-height: 1;
    text-decoration: none;
  }

  .hk-logo:hover {
    text-decoration: none;
  }

  .hk-logo-en,
  .hk-logo-ko {
    display: block !important;
    white-space: nowrap;
  }

  .hk-logo-en {
    font-family: "Playfair Display", serif;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.18em;
  }

  .hk-logo-ko {
    margin-top: 0.28rem;
    font-family: "Noto Serif KR", "Apple SD Gothic Neo", serif;
    font-size: 0.66rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.05em;
  }

  .hk-desktop-navigation {
    display: flex;
    flex: 0 1 auto;
    flex-wrap: nowrap;
    align-items: flex-start;
    align-self: flex-start;
    min-width: 0;
    margin-inline-start: auto;
    padding: 0;
    white-space: nowrap;
  }

  .hk-main-navigation {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: clamp(0.55rem, 0.9vw, 0.9rem);
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  .hk-main-navigation a {
    display: flex;
    flex: 0 0 auto;
    align-items: flex-start;
    justify-content: center;
    margin: 0 !important;
    padding: 0 !important;
    color: #fff;
    opacity: 0.76;
    font-family: "Playfair Display", "Noto Serif KR", serif;
    font-size: 0.73rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.15em;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  :global(html[lang="ko"]) .hk-main-navigation a {
    font-family: "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
    letter-spacing: 0.04em;
  }

  :global(html[lang="ko"]) .hk-logo-ko {
    font-family: "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
  }

  .hk-main-navigation a:hover,
  .hk-main-navigation a.is-active {
    opacity: 1;
    border-bottom-color: #fff;
    text-decoration: none;
  }

  .hk-main-navigation .hk-home-link {
    position: relative;
    top: -4px;
    width: 24px;
    height: 20px;
    padding: 0 !important;
    border-bottom: 0;
  }

  .hk-home-link img {
    display: block;
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .hk-language-navigation {
    position: relative;
    top: 1px;
    display: flex;
    flex: 0 0 auto;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0 0 0 0.78rem;
    padding: 0 0 0 0.72rem;
    border-inline-start: 1px solid rgba(255, 255, 255, 0.28);
    white-space: nowrap;
  }

  .hk-language-navigation a {
    display: block;
    margin: 0 !important;
    padding: 0 !important;
    color: #fff;
    opacity: 0.75;
    font-family: "Inter", "Noto Sans KR", sans-serif;
    font-size: 0.62rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .hk-language-navigation a:hover {
    opacity: 1;
    text-decoration: none;
  }

  .hk-menu-button {
    display: none;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    margin-inline-start: auto;
    padding: 10px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .hk-menu-button span {
    display: block;
    width: 22px;
    height: 1px;
    margin: 5px auto;
    background: #fff;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .hk-menu-button[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .hk-menu-button[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .hk-menu-button[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .hk-mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding:
      max(6.3rem, env(safe-area-inset-top))
      1.5rem
      max(2rem, env(safe-area-inset-bottom));
    background: rgba(0, 0, 0, 0.97);
  }

  .hk-mobile-menu[hidden] {
    display: none;
  }

  .hk-mobile-main-navigation {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
  }

  .hk-mobile-main-navigation a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.65rem;
    color: #fff;
    opacity: 0.76;
    font-family: "Playfair Display", "Noto Serif KR", serif;
    font-size: 1.05rem;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  :global(html[lang="ko"]) .hk-mobile-main-navigation a {
    font-family: "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
    letter-spacing: 0.04em;
  }

  .hk-mobile-main-navigation a:hover,
  .hk-mobile-main-navigation a.is-active {
    opacity: 1;
  }

  .hk-mobile-home-link img {
    display: block;
    width: 28px;
    height: 28px;
  }

  .hk-mobile-language-navigation {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 1.2rem;
    margin-top: 1.4rem;
    padding-top: 1.15rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    white-space: nowrap;
  }

  .hk-mobile-language-navigation a {
    padding: 0.65rem;
    color: #fff;
    opacity: 0.8;
    font-family: "Inter", "Noto Sans KR", sans-serif;
    font-size: 0.82rem;
    line-height: 1;
    text-decoration: none;
  }

  :global(body.hk-menu-open) {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .hk-header {
      align-items: center;
      padding:
        max(0.55rem, env(safe-area-inset-top))
        max(0.9rem, env(safe-area-inset-right))
        0.55rem
        max(0.9rem, env(safe-area-inset-left));
    }

    .hk-desktop-navigation {
      display: none;
    }

    .hk-menu-button {
      display: block;
      position: relative;
      z-index: 3;
    }

    .hk-logo {
      position: relative !important;
      z-index: 3;
    }
  }

  @media (max-width: 520px) {
    .hk-header {
      min-height: 56px;
    }

    .hk-logo-en {
      font-size: 0.66rem;
      letter-spacing: 0.14em;
    }

    .hk-logo-ko {
      font-size: 0.56rem;
    }
  }
</style>
