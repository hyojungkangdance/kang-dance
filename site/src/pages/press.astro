---

<PageLayout
  title="Press – Hyo-Jung Kang | Reviews, Interviews & Articles"
  description="Press reviews, interviews, performance announcements and feature articles on principal dancer Hyo-Jung Kang from recognised media, ballet companies and opera houses in Europe and Korea."
  lang="en"
  activePage="press"
  pageClass="press-page"
>
  <h1>press</h1>

  <p class="press-introduction">
    Selected reviews, features, interviews and official performance
    announcements from international newspapers, magazines, ballet
    companies and opera houses.
  </p>

  <section
    class="press-archive"
    aria-label="Press coverage"
  >
    <ul class="press-list">
      {
        pressItems.map((item) => (
          <li class="press-item">
            <div class="press-meta">
              <span class="press-source">
                {item.source}
              </span>

              <span class="press-date">
                {item.date}
              </span>
            </div>

            <a
              class="press-link"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</PageLayout>

<style>
  .press-introduction {
    max-width: 48rem;
    margin-bottom: 1.8rem;
  }

  .press-archive {
    width: 100%;
    max-width: 54rem;
    padding-bottom: 4rem;
  }

  .press-list {
    display: block;

    width: 100%;
    margin: 0;
    padding: 0;

    list-style: none;
  }

  .press-item {
    margin: 0;
    padding: 0 0 1.05rem;

    border-bottom:
      1px solid rgba(255, 255, 255, 0.13);
  }

  .press-item + .press-item {
    margin-top: 1.05rem;
  }

  .press-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;

    margin: 0 0 0.3rem;
    padding: 0;
  }

  .press-source {
    font-family: "Inter", sans-serif;
    font-size: 0.82rem;
    font-weight: 400;
    line-height: 1.35;

    color: rgba(255, 255, 255, 0.78);
  }

  .press-date {
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 300;
    line-height: 1.35;

    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
  }

  .press-link {
    display: inline;

    font-family: "Inter", sans-serif;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;

    color: #fff;

    text-decoration-line: underline;
    text-decoration-color: rgba(255, 255, 255, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;

    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }

  .press-link:hover,
  .press-link:focus-visible {
    color: rgba(255, 255, 255, 0.8);
    text-decoration-color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 700px) {
    .press-introduction {
      margin-bottom: 1.4rem;
    }

    .press-archive {
      padding-bottom: 3rem;
    }

    .press-item {
      padding-bottom: 0.9rem;
    }

    .press-item + .press-item {
      margin-top: 0.9rem;
    }

    .press-meta {
      gap: 0.18rem 0.55rem;
      margin-bottom: 0.24rem;
    }

    .press-source {
      font-size: 0.76rem;
    }

    .press-date {
      font-size: 0.68rem;
    }

    .press-link {
      font-size: 0.94rem;
      line-height: 1.45;
    }
  }
</style>