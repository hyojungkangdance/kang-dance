---
import PageLayout from "../../layouts/PageLayout.astro";

const videos = [
  {
    title: "빈 국립발레단 〈잠자는 숲속의 미녀〉 리허설",
    caption: "빈 국립발레단 스튜디오 리허설 영상입니다.",
    youtubeId: "UqJhrVKimPY",
  },
  {
    title: "글로벌 성공시대, 세계를 품다 – 강효정",
    caption: "강효정의 국제적인 발레 경력을 소개하는 방송 영상입니다.",
    youtubeId: "UIcDlZ2Vuf0",
  },
  {
    title: "빈 국립발레단 〈잠자는 숲속의 미녀〉",
    caption: "빈 국립오페라극장 무대 공연 영상입니다.",
    youtubeId: "1v2cnQFDSQI",
  },
  {
    title: "서울시발레단 – Class With Me",
    caption: "서울시발레단과 함께한 발레 클래스 영상입니다.",
    youtubeId: "UNQZoszXPJQ",
  },
] as const;
---

<PageLayout
  title="강효정 공연 영상 | 발레 공연·리허설·클래스"
  description="강효정 발레리나의 공연, 리허설, 발레 클래스와 주요 무대 영상을 소개합니다."
  lang="ko"
  activePage="media"
  pageClass="media-page"
  ogImage="/assets/images/media_bg.jpg"
>
  <h1>미디어</h1>

  <p class="media-introduction">
    강효정의 공연, 리허설 및 발레 클래스 영상 중 일부를 소개합니다.
  </p>

  <section class="ko-video-grid" aria-label="강효정 공연 영상">
    {
      videos.map((video) => (
        <article class="ko-video-card">
          <h2>{video.title}</h2>

          <div class="ko-video-frame">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`}
              title={video.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>

          <p>{video.caption}</p>
        </article>
      ))
    }
  </section>
</PageLayout>

<style>
  .media-introduction {
    max-width: 48rem;
    margin-bottom: 1.8rem;
    line-height: 1.8;
  }

  .ko-video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    width: 100%;
    max-width: 62rem;
    padding-bottom: 4rem;
  }

  .ko-video-card {
    min-width: 0;
  }

  .ko-video-card h2 {
    margin: 0 0 0.65rem;
    font-family: "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
    font-size: 1rem;
    line-height: 1.55;
    letter-spacing: 0.02em;
  }

  .ko-video-frame {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    overflow: hidden;
    background: #000;
  }

  .ko-video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ko-video-card p {
    margin-top: 0.65rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.86rem;
    line-height: 1.7;
    word-break: keep-all;
  }

  @media (max-width: 760px) {
    .ko-video-grid {
      grid-template-columns: 1fr;
      gap: 1.3rem;
      padding-bottom: 3rem;
    }
  }
</style>
