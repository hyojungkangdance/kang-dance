---

<PageLayout
  title="강효정 언론 보도 | 인터뷰·공연 리뷰·기사"
  description="강효정 발레리나의 국내외 인터뷰, 공연 리뷰, 기사, 공식 프로필과 서울 및 유럽 공연 보도를 모았습니다."
  lang="ko"
  activePage="press"
  pageClass="press-page"
  ogImage="/assets/images/press_bg.jpg"
>
  <h1>언론 보도</h1>

  <p class="press-introduction">
    강효정의 국내외 인터뷰, 공연 리뷰, 공식 프로필 및 공연 관련
    기사를 소개합니다.
  </p>

  <section class="press-archive" aria-label="강효정 언론 보도 목록">
    <ul class="press-list">
      {
        pressItems.map((item) => (
          <li class="press-item">
            <div class="press-meta">
              <span class="press-source">{item.source}</span>
              <span class="press-date">{item.date}</span>
            </div>

            <a
              class="press-link"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</PageLayout>

<style>
  .press-introduction {
    max-width: 48rem;
    margin-bottom: 1.8rem;
    line-height: 1.8;
    word-break: keep-all;
  }

  .press-archive {
    width: 100%;
    max-width: 56rem;
    padding-bottom: 4rem;
  }

  .press-list {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .press-item {
    margin: 0;
    padding: 0 0 1.05rem;
    border-bottom: 0;
  }

  .press-item + .press-item {
    margin-top: 1.05rem;
  }

  .press-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.3rem;
  }

  .press-source {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .press-date {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.72rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  .press-link {
    color: #fff;
    font-family: "Noto Sans KR", "Apple SD Gothic Neo", sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    text-decoration-line: underline;
    text-decoration-color: rgba(255, 255, 255, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    word-break: keep-all;
  }

  .press-link:hover,
  .press-link:focus-visible {
    color: rgba(255, 255, 255, 0.8);
    text-decoration-color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 700px) {
    .press-archive {
      padding-bottom: 3rem;
    }

    .press-item {
      padding-bottom: 0.9rem;
    }

    .press-item + .press-item {
      margin-top: 0.9rem;
    }

    .press-source {
      font-size: 0.76rem;
    }

    .press-date {
      font-size: 0.68rem;
    }

    .press-link {
      font-size: 0.94rem;
      line-height: 1.55;
    }
  }
</style>
