---
const links = [
  { href: "/", label: "English" },
  { href: "/de/", label: "Deutsch" },
  { href: "/ko/", label: "\ud55c\uad6d\uc5b4" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found - Hyo-Jung Kang</title>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 2rem; background: #000; color: #fff; font-family: Arial, sans-serif; text-align: center; }
      h1 { margin: 0 0 1rem; font-family: Georgia, serif; font-weight: 500; letter-spacing: .08em; }
      p { color: #ccc; }
      nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: 1.5rem; }
      a { color: #fff; text-underline-offset: .25em; }
    </style>
  </head>
  <body>
    <main>
      <h1>404</h1>
      <p>This page could not be found.</p>
      <nav aria-label="Language homepages">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </main>
  </body>
</html>
