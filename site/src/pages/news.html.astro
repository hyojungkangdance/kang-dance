---
import PageLayout from "../layouts/PageLayout.astro";

const eventSchema = {
  "@type": "Event",
  name: "Seoul Metropolitan Ballet - Death and the Maiden",
  startDate: "2026-08-15T14:00:00+09:00",
  endDate: "2026-08-16T16:00:00+09:00",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: "Haeoreum Grand Theater, National Theater of Korea",
    address: {
      "@type": "PostalAddress",
      streetAddress: "59 Jangchungdan-ro",
      addressLocality: "Jung-gu",
      addressRegion: "Seoul",
      addressCountry: "KR",
    },
  },
  performer: {
    "@type": "Person",
    "@id": "https://kang.dance/#hyo-jung-kang",
    name: "Hyo-Jung Kang",
  },
  url: "https://admin.sejongpac.or.kr/season/season2026/seasonProgram.do",
};
---

<PageLayout
  title="News - Hyo-Jung Kang | Performances and Announcements"
  description="Current performance announcements, ticket information and artistic news from Hyo-Jung Kang."
  lang="en"
  activePage="news"
  pageClass="news-page"
  ogImage="/assets/images/press_bg.jpg"
  pageSchema={eventSchema}
>
  <h1>news</h1>

  <p class="news-introduction">
    Current performances, announcements and selected artistic updates.
  </p>

  <article class="news-card news-card-featured">
    <div class="news-meta">
      <span>15-16 August 2026</span>
      <span>Seoul</span>
    </div>

    <h2>Seoul Metropolitan Ballet - <em>Death and the Maiden</em></h2>

    <p>
      Hyo-Jung Kang appears in the Seoul Metropolitan Ballet programme at the Haeoreum Grand Theater of the National Theater of Korea. The double bill includes work by Christian Spuck.
    </p>

    <dl class="event-details">
      <div><dt>Dates</dt><dd>15-16 August 2026</dd></div>
      <div><dt>Venue</dt><dd>Haeoreum Grand Theater, National Theater of Korea, Seoul</dd></div>
      <div><dt>Company</dt><dd>Seoul Metropolitan Ballet</dd></div>
    </dl>

    <a class="news-button" href="https://admin.sejongpac.or.kr/season/season2026/seasonProgram.do" target="_blank" rel="noopener noreferrer">
      Performance information
    </a>
  </article>

  <article class="news-card">
    <div class="news-meta">
      <span>June 2026</span>
      <span>Semperoper Dresden</span>
    </div>

    <h2>John Cranko's <em>Onegin</em> - Tatiana</h2>

    <p>
      Hyo-Jung Kang danced Tatiana in the Semperoper Ballett premiere of John Cranko's <em>Onegin</em>. Reviews highlighted her experience in the role, musicality and emotional depth.
    </p>

    <a class="news-text-link" href="https://www.semperoper.de/spielplan/stuecke/62703-onegin/interview.html" target="_blank" rel="noopener noreferrer">
      Read the official Semperoper interview
    </a>
  </article>
</PageLayout>

<style>
  .news-introduction { max-width: 48rem; margin-bottom: 1.8rem; }
  .news-card { max-width: 52rem; margin-top: 1.4rem; padding: 1.4rem; border: 1px solid rgba(255,255,255,.18); background: rgba(0,0,0,.3); backdrop-filter: blur(4px); }
  .news-card-featured { border-color: rgba(255,255,255,.34); }
  .news-meta { display: flex; flex-wrap: wrap; gap: .25rem .85rem; margin-bottom: .65rem; color: rgba(255,255,255,.62); font-size: .76rem; }
  .news-card h2 { margin: 0 0 .85rem; font-size: 1.25rem; line-height: 1.5; letter-spacing: .04em; text-transform: none; }
  .news-card p { line-height: 1.8; }
  .event-details { margin: 1.2rem 0; padding: 0; }
  .event-details div { display: grid; grid-template-columns: 5rem minmax(0,1fr); gap: .75rem; padding: .45rem 0; border-bottom: 1px solid rgba(255,255,255,.12); }
  .event-details dt { color: rgba(255,255,255,.62); }
  .event-details dd { margin: 0; }
  .news-button, .news-text-link { display: inline-block; margin-top: .7rem; color: #fff; text-underline-offset: .22em; }
  .news-button { padding: .7rem 1rem; border: 1px solid rgba(255,255,255,.55); text-decoration: none; }
  .news-button:hover, .news-button:focus-visible { background: #fff; color: #000; }
  @media (max-width: 600px) { .news-card { padding: 1.05rem; } .event-details div { grid-template-columns: 1fr; gap: .15rem; } }
</style>
