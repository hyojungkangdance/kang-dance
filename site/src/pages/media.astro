---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
  title="Media – Hyo-Jung Kang | Performances and Videos"
  description="Selected performance and rehearsal videos featuring principal dancer Hyo-Jung Kang."
  lang="en"
  activePage="media"
  pageClass="media-page"
>
  <h1>media</h1>

  <section class="media-section">
    <p>
      A selection of video recordings featuring Hyo-Jung Kang in
      performance and rehearsal.
    </p>

    <div class="media-videos">
      <div class="video-embed">
        <h2>
          Vienna State Ballet –
          <em>Sleeping Beauty</em>
          (rehearsal impressions)
        </h2>

        <div class="video-inner">
          <iframe
            src="https://www.youtube-nocookie.com/embed/UqJhrVKimPY"
            title="Vienna State Ballet – Sleeping Beauty rehearsal impressions"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        <p class="video-caption">
          Studio rehearsal at Vienna State Ballet.
        </p>
      </div>

      <div class="video-embed">
        <h2>
          <em>Le Jeune Homme et la Mort</em>
          – Kang &amp; Mansilla
        </h2>

        <div class="video-inner">
          <iframe
            src="https://www.youtube-nocookie.com/embed/amUy8vbZzt8"
            title="Le Jeune Homme et la Mort – Kang and Mansilla"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        <p class="video-caption">
          Pas de deux performance.
        </p>
      </div>

      <div class="video-embed">
        <h2>
          Vienna State Ballet –
          <em>Sleeping Beauty</em>
        </h2>

        <div class="video-inner">
          <iframe
            src="https://www.youtube-nocookie.com/embed/1v2cnQFDSQI"
            title="Vienna State Ballet – Sleeping Beauty"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        <p class="video-caption">
          Stage performance at Vienna State Opera.
        </p>
      </div>

      <div class="video-embed">
        <h2>
          Seoul Metropolitan Ballet – Class With Me
        </h2>

        <div class="video-inner">
          <iframe
            src="https://www.youtube-nocookie.com/embed/UNQZoszXPJQ"
            title="Seoul Metropolitan Ballet – Class With Me"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        <p class="video-caption">
          Company class with Seoul Metropolitan Ballet.
        </p>
      </div>
    </div>
  </section>
</PageLayout>