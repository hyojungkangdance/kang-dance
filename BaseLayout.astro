---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  lang?: "en" | "de" | "ko";
  canonicalPath?: string;
  bodyClass?: string;
  ogImage?: string;
  activePage?: string;
}

const {
  title,
  description,
  lang = "en",
  canonicalPath = "/",
  bodyClass = "",
  ogImage = "/assets/images/og-image.png",
  activePage = "",
} = Astro.props;

const siteUrl = "https://kang.dance";
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const absoluteOgImage = new URL(ogImage, siteUrl).toString();

const localeMap = {
  en: "en_US",
  de: "de_AT",
  ko: "ko_KR",
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://kang.dance/#hyo-jung-kang",
  name: "Hyo-Jung Kang",
  alternateName: [
    "강효정",
    "Hyojung Kang",
    "Hyo Jung Kang",
    "Kang Hyo-jung",
  ],
  jobTitle: "Principal Dancer",
  url: "https://kang.dance/",
  image: "https://kang.dance/assets/images/og-image.png",
  sameAs: [
    "https://www.instagram.com/hyojung_kang_/",
    "https://www.linkedin.com/in/hyo-jung-kang-b7973a37/",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />

    <link rel="alternate" hreflang="en" href="https://kang.dance/" />
    <link rel="alternate" hreflang="de" href="https://kang.dance/de/" />
    <link rel="alternate" hreflang="ko" href="https://kang.dance/ko/" />
    <link rel="alternate" hreflang="x-default" href="https://kang.dance/" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Noto+Sans+KR:wght@300;400;500&family=Noto+Serif+KR:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hyo-Jung Kang" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:locale" content={localeMap[lang]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    ></script>
  </head>

  <body class={bodyClass}>
    <Header lang={lang} activePage={activePage} />

    <slot />
  </body>
</html>